# ==============================================================================
# PulseBridge Environment Variables
# Copy to .env.local for local development with Supabase backend.
# If these variables are not provided, PulseBridge automatically runs in DEMO MODE.
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase Anon / Public Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=

# Note: NEVER include service-role keys, database passwords, or private API keys here.
